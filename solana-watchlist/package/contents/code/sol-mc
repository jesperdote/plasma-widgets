#!/usr/bin/env python3
"""Backend for the Solana Watchlist Plasma widget; also usable on its own from a terminal.

Market data, both public and keyless: DexScreener (for each token, the pair with the most
liquidity) gives supply, market cap and the 5m/1h/6h/24h changes, but is CDN-cached for
30 s; Jupiter's price API is fresh to ~5 s, so its price is laid on top and the market cap
scaled to it. Watchlist: ~/.config/sol-mc/watchlist, one token (mint)
address per line, optional label after it; `#` comments allowed. A leading `-` hides that
token from the panel (still listed, and fetched, in the popup). Each source is fetched in
one request (max 30 tokens) and cached locally for as long as its CDN caches it.

Market-cap alerts (~/.config/sol-mc/alerts.json): per token, "above" and/or "below" a
level. Checked on every run; when the market cap reaches or crosses a level, a desktop
notification (with sound) is sent and that alert is deleted (one-shot). A level the market
cap is already past isn't saved.

  sol-mc            one-line summary, e.g. "◎ BONK $272M 5m ▲0.1% 1h ▼0.6% 6h ▲2.1% 24h ▼1.0%"
  sol-mc --tooltip  one line per token: name, market cap, price, changes
  sol-mc --json     all tokens as JSON (what the widget reads)
  sol-mc --add / --remove / --hide / --show ADDRESS   change the watchlist, then print --json
  sol-mc --alert ADDRESS above|below AMOUNT|off [...]  set/clear alerts (AMOUNT like 50M, 1.2B)
  sol-mc --sounds | --set-sound PATH|none | --play PATH   pick / preview the alert sound
"""
import json
import os
import re
import subprocess
import sys
import time
import urllib.request

CONF = os.path.expanduser("~/.config/sol-mc/watchlist")
ALERTS = os.path.expanduser("~/.config/sol-mc/alerts.json")
SOUND_SETTING = os.path.expanduser("~/.config/sol-mc/alert-sound")  # a sound file path, or "none"
SOUND_DIRS = ["/usr/share/sounds/ocean/stereo", os.path.expanduser("~/.local/share/sounds")]
DEFAULT_SOUND = "/usr/share/sounds/ocean/stereo/message-attention.oga"
CACHE = os.path.expanduser("~/.cache/sol-mc.json")
JUP_CACHE = os.path.expanduser("~/.cache/sol-mc-jupiter.json")
API = "https://api.dexscreener.com/latest/dex/tokens/{}"
JUP_API = "https://lite-api.jup.ag/price/v3?ids={}"
DS_MAX_AGE = 30   # DexScreener: Cache-Control max-age=30, polling faster returns the same data
JUP_MAX_AGE = 5   # Jupiter lite: max-age=5, and only ~5 requests per 10 s before HTTP 429
JUP_STALE = 30    # past this, a failed Jupiter fetch means DexScreener's own price is used
MAX_IN_PANEL = 3
ADDRESS_RE = re.compile(r"^[1-9A-HJ-NP-Za-km-z]{32,44}$")  # base58
HIDDEN = set()  # addresses written with a leading "-" in the watchlist


def read_watchlist():
    tokens = []
    try:
        with open(CONF) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if line:
                    addr, _, label = line.partition(" ")
                    if addr.startswith("-"):
                        addr = addr[1:]
                        HIDDEN.add(addr)
                    tokens.append((addr, label.strip()))
    except FileNotFoundError:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w") as f:
            f.write("# One Solana token address per line, optional label after it.\n")
    return tokens


def fetch(addresses):
    """{address: best pair} for up to 30 addresses in one DexScreener call."""
    req = urllib.request.Request(API.format(",".join(addresses)), headers={"User-Agent": "sol-mc"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        pairs = json.load(resp).get("pairs") or []
    best = {}
    for p in pairs:
        addr = p.get("baseToken", {}).get("address")
        if addr in addresses:
            liq = (p.get("liquidity") or {}).get("usd", 0)
            if addr not in best or liq > (best[addr].get("liquidity") or {}).get("usd", 0):
                best[addr] = p
    return best


def cached(path, addrs, max_age, fetcher):
    """(value, fetched_at) from a JSON file cache, refetched when older than max_age."""
    try:
        with open(path) as f:
            cache = json.load(f)
        if cache["addrs"] != addrs:
            cache = None
        elif time.time() - cache["at"] < max_age:
            return cache["value"], cache["at"]
    except (OSError, ValueError, KeyError):
        cache = None
    try:
        value = fetcher(addrs)
    except Exception:
        # Offline / API hiccup / rate limited: keep the last good numbers.
        return (cache["value"], cache["at"]) if cache else ({}, 0)
    with open(path + ".tmp", "w") as f:
        json.dump({"at": time.time(), "addrs": addrs, "value": value}, f)
    os.replace(path + ".tmp", path)
    return value, time.time()


SOL_MINT = "So11111111111111111111111111111111111111112"
SOL_INFO = {}  # SOL's own price and 24h change, filled by data() for the panel's SOL readout


def fetch_jupiter(addresses):
    """{address: [USD price, 24h change %]} from Jupiter; SOL is always asked for too."""
    ids = list(dict.fromkeys(list(addresses) + [SOL_MINT]))
    req = urllib.request.Request(JUP_API.format(",".join(ids)), headers={"User-Agent": "sol-mc"})
    with urllib.request.urlopen(req, timeout=5) as resp:
        return {a: [float(v["usdPrice"]), v.get("priceChange24h")]
                for a, v in json.load(resp).items() if v and v.get("usdPrice")}


def data(tokens):
    addrs = [a for a, _ in tokens][:30]
    pairs, at = cached(CACHE, addrs, DS_MAX_AGE, fetch)
    prices, jup_at = cached(JUP_CACHE, addrs, JUP_MAX_AGE, fetch_jupiter)
    # Older caches hold a bare price per address.
    prices = {a: (v if isinstance(v, list) else [v, None]) for a, v in prices.items()}
    if SOL_MINT in prices:
        SOL_INFO.update(price=prices[SOL_MINT][0], change24h=prices[SOL_MINT][1])
    if not prices or time.time() - jup_at > JUP_STALE:
        return pairs, at
    live = {}
    for addr, p in pairs.items():
        p = dict(p)
        old, new = float(p.get("priceUsd") or 0), (prices.get(addr) or [None])[0]
        if old > 0 and new:
            # Supply doesn't change between DexScreener refreshes, so MC scales with price.
            for key in ("marketCap", "fdv"):
                if p.get(key):
                    p[key] = p[key] * new / old
            p["priceUsd"] = f"{new:.10g}"
            p["live"] = True
        live[addr] = p
    return live, max(at, jup_at)


def money(v):
    v = float(v or 0)
    for unit, div in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if v >= div:
            return f"${v / div:.1f}{unit}" if v / div < 100 else f"${v / div:.0f}{unit}"
    return f"${v:.0f}"


def change(p, windows=("m5", "h1", "h6", "h24")):
    """Price change per DexScreener window, e.g. "5m ▲0.7% 1h ▲0.3% 6h ▼2.7% 24h ▼10%"."""
    out = []
    for w in windows:
        c = (p.get("priceChange") or {}).get(w)
        if c is None:  # DexScreener drops a window with no trades / no movement in it
            out.append(f"{w[1:]}{w[0]} –")
            continue
        pct = f"{abs(c):.1f}" if abs(c) < 10 else f"{abs(c):.0f}"
        out.append(f"{w[1:]}{w[0]} {'▲' if c >= 0 else '▼'}{pct}%")
    return " ".join(out)


def name(p, label, full=False):
    t = p.get("baseToken", {})
    short = label or t.get("symbol", "?")
    return f"{t.get('name', '?')} ({short})" if full else short


def panel(tokens, pairs):
    tokens = [t for t in tokens if t[0] not in HIDDEN]
    if not tokens:
        return "◎ add token"
    parts = []
    for addr, label in tokens[:MAX_IN_PANEL]:
        p = pairs.get(addr)
        parts.append(f"{name(p, label)} {money(p.get('marketCap') or p.get('fdv'))} {change(p)}".strip() if p else f"{label or addr[:4]} ?")
    more = f" +{len(tokens) - MAX_IN_PANEL}" if len(tokens) > MAX_IN_PANEL else ""
    return "◎ " + " · ".join(parts) + more


def tooltip(tokens, pairs, at):
    if not tokens:
        return "No tokens yet - click to add a Solana token address"
    lines = []
    for addr, label in tokens:
        p = pairs.get(addr)
        if not p:
            lines.append(f"{label or addr}: no DexScreener pair found")
            continue
        lines.append(f"{name(p, label, full=True)}: MC {money(p.get('marketCap') or p.get('fdv'))} · "
                     f"${p.get('priceUsd', '?')} · {change(p) or 'no change data'}")
    age = int((time.time() - at) / 60) if at else None
    if age and age > 2:
        lines.append(f"(as of {age} min ago)")
    lines.append("Click to add / remove tokens")
    return "\n".join(lines)


def line(addr, label):
    return f"{'-' if addr in HIDDEN else ''}{addr} {label}".strip()


def write_watchlist(lines):
    with open(CONF, "w") as f:
        f.write("# One Solana token address per line, optional label after it.\n")
        f.writelines(l + "\n" for l in lines)


def add(tokens, addr):
    """Validate against DexScreener, then append. Returns (ok, message)."""
    addr = addr.strip()
    if not ADDRESS_RE.match(addr):
        return False, "That doesn't look like a Solana address."
    if addr in (a for a, _ in tokens):
        return False, "Already on the watchlist."
    try:
        p = fetch([addr]).get(addr)
    except Exception as e:
        return False, f"DexScreener lookup failed: {e}"
    if not p:
        return False, "DexScreener has no trading pair for that address."
    t = p["baseToken"]
    write_watchlist([line(a, l) for a, l in tokens] + [line(addr, t.get("symbol", ""))])
    return True, f"Added {t.get('name')} ({t.get('symbol')})"


def parse_amount(text):
    """"50M" / "$1.2b" / "300,000" -> float, or None."""
    m = re.fullmatch(r"\$?\s*([0-9][0-9,]*\.?[0-9]*)\s*([kmb]?)", text.strip().lower())
    if not m:
        return None
    return float(m.group(1).replace(",", "")) * {"": 1, "k": 1e3, "m": 1e6, "b": 1e9}[m.group(2)]


def mc_of(p):
    return float((p or {}).get("marketCap") or (p or {}).get("fdv") or 0)


def load_alerts():
    try:
        with open(ALERTS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_alerts(alerts):
    os.makedirs(os.path.dirname(ALERTS), exist_ok=True)
    with open(ALERTS + ".tmp", "w") as f:
        json.dump(alerts, f, indent=1)
    os.replace(ALERTS + ".tmp", ALERTS)


def reached(direction, mc, level):
    return mc >= level if direction == "above" else mc <= level


def list_sounds():
    out = []
    for d in SOUND_DIRS:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if n.endswith((".oga", ".ogg", ".wav")) and "silent" not in n:
                out.append({"name": n.rsplit(".", 1)[0].replace("-", " "), "path": os.path.join(d, n)})
    return out


def current_sound():
    try:
        with open(SOUND_SETTING) as f:
            v = f.read().strip()
        return v if v == "none" or os.path.isfile(v) else DEFAULT_SOUND
    except OSError:
        return DEFAULT_SOUND


def play(path):
    """Play a sound without waiting for it (first player found: PipeWire, PulseAudio, libcanberra)."""
    if not path or path == "none" or not os.path.isfile(path):
        return
    for player in (["pw-play"], ["paplay"], ["canberra-gtk-play", "-f"]):
        try:
            subprocess.Popen(player + [path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            return
        except OSError:
            continue


def notify(title, body):
    try:
        subprocess.run(["notify-send", "--app-name=Solana Watchlist", "--icon=office-chart-line",
                        "--urgency=critical", title, body], timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        pass
    play(current_sound())


def check_alerts(tokens, pairs):
    """Fire and delete every alert whose level the market cap has reached."""
    alerts = load_alerts()
    changed = False
    labels = dict(tokens)
    for addr in list(alerts):
        p = pairs.get(addr)
        mc = mc_of(p)
        if not mc:
            continue
        for direction in list(alerts[addr]):
            level = alerts[addr][direction]["level"]
            if reached(direction, mc, level):
                sym = labels.get(addr) or p.get("baseToken", {}).get("symbol", addr[:4])
                word = "up to" if direction == "above" else "down to"
                notify(f"{sym} market cap {word} {money(level)}", f"Now {money(mc)} (alert: {direction} {money(level)}, now cleared)")
                del alerts[addr][direction]
                changed = True
        if not alerts[addr]:
            del alerts[addr]
    if changed:
        save_alerts(alerts)
    return alerts


def set_alert(tokens, addr, direction, amount):
    if addr not in (a for a, _ in tokens):
        return False, "Not on the watchlist."
    if direction not in ("above", "below"):
        return False, "Direction must be above or below."
    alerts = load_alerts()
    if amount == "off":
        alerts.get(addr, {}).pop(direction, None)
        if not alerts.get(addr):
            alerts.pop(addr, None)
        save_alerts(alerts)
        return True, f"Alert {direction} cleared"
    level = parse_amount(amount)
    if not level:
        return False, "Enter an amount like 50M, 1.2B or 300K."
    pairs, _ = data(tokens)
    mc = mc_of(pairs.get(addr))
    if mc and reached(direction, mc, level):
        return False, f"Not saved: market cap is already {direction} {money(level)} ({money(mc)})"
    alerts.setdefault(addr, {})[direction] = {"level": level}
    save_alerts(alerts)
    return True, f"Alert set: {direction} {money(level)}"


def as_json(tokens, pairs, at, alerts=None):
    """Everything the widget shows, one object per token."""
    out = []
    for addr, label in tokens:
        p = pairs.get(addr)
        t = (p or {}).get("baseToken", {})
        out.append({
            "address": addr,
            "symbol": label or t.get("symbol") or addr[:4],
            "name": t.get("name", ""),
            "found": bool(p),
            "hidden": addr in HIDDEN,
            "marketCap": money(p.get("marketCap") or p.get("fdv")) if p else "",
            "price": p.get("priceUsd", "") if p else "",
            "changes": (p or {}).get("priceChange") or {},
            "url": (p or {}).get("url") or f"https://dexscreener.com/solana/{addr}",
            "alerts": {d: {"level": a["level"], "text": money(a["level"])}
                       for d, a in (alerts or {}).get(addr, {}).items()},
        })
    return {"tokens": out, "age": int(time.time() - at) if at else None, "sol": dict(SOL_INFO) or None}


def main():
    tokens = read_watchlist()
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    arg = sys.argv[2] if len(sys.argv) > 2 else ""
    if mode == "--sounds":
        print(json.dumps({"current": current_sound(), "sounds": list_sounds()}))
        return
    if mode == "--set-sound":
        if arg != "none" and arg not in (x["path"] for x in list_sounds()):
            print(json.dumps({"ok": False, "message": "Unknown sound."}))
            return
        os.makedirs(os.path.dirname(SOUND_SETTING), exist_ok=True)
        with open(SOUND_SETTING, "w") as f:
            f.write(arg + "\n")
        print(json.dumps({"ok": True, "current": arg}))
        return
    if mode == "--play":
        if arg in (x["path"] for x in list_sounds()):
            play(arg)
        return
    if mode in ("--add", "--remove", "--hide", "--show", "--alert"):
        arg = sys.argv[2] if len(sys.argv) > 2 else ""
        if mode == "--add":
            ok, msg = add(tokens, arg)
        elif mode == "--alert":
            # One or more "above|below AMOUNT|off" pairs.
            pairs_ = list(zip(sys.argv[3::2], sys.argv[4::2])) or [("", "")]
            results = [set_alert(tokens, arg, d, a) for d, a in pairs_]
            ok, msg = all(r[0] for r in results), "; ".join(r[1] for r in results)
        else:
            if mode == "--remove":
                alerts = load_alerts()
                if alerts.pop(arg, None) is not None:
                    save_alerts(alerts)
            if mode == "--hide":
                HIDDEN.add(arg)
            elif mode == "--show":
                HIDDEN.discard(arg)
            write_watchlist([line(a, l) for a, l in tokens if not (mode == "--remove" and a == arg)])
            ok, msg = True, {"--remove": "Removed", "--hide": "Hidden from the panel", "--show": "Shown on the panel"}[mode]
        HIDDEN.clear()
        tokens = read_watchlist()
        pairs, at = data(tokens) if tokens else ({}, 0)
        print(json.dumps({"ok": ok, "message": msg, **as_json(tokens, pairs, at, load_alerts())}))
        return
    pairs, at = data(tokens) if tokens else ({}, 0)
    alerts = check_alerts(tokens, pairs)
    if mode == "--json":
        print(json.dumps(as_json(tokens, pairs, at, alerts)))
    else:
        print(tooltip(tokens, pairs, at) if mode == "--tooltip" else panel(tokens, pairs))


if __name__ == "__main__":
    main()
