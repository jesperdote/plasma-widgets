#!/usr/bin/env python3
"""Backend for the Solana Watchlist Plasma widget; also usable on its own from a terminal.

Market data, both public and keyless: DexScreener (for each token, the pair with the most
liquidity) gives supply, market cap and the 5m/1h/6h/24h changes, but is CDN-cached for
30 s; Jupiter's price API is fresh to ~5 s, so its price is laid on top and the market cap
scaled to it. Watchlist: ~/.config/sol-mc/watchlist, one token (mint)
address per line, optional label after it; `#` comments allowed. A leading `-` hides that
token from the panel (still listed, and fetched, in the popup). Each source is fetched in
one request (max 30 tokens) and cached locally for as long as its CDN caches it.

  sol-mc            one-line summary, e.g. "◎ BONK $272M 5m ▲0.1% 1h ▼0.6% 6h ▲2.1% 24h ▼1.0%"
  sol-mc --tooltip  one line per token: name, market cap, price, changes
  sol-mc --json     all tokens as JSON (what the widget reads)
  sol-mc --add / --remove / --hide / --show ADDRESS   change the watchlist, then print --json
"""
import json
import os
import re
import sys
import time
import urllib.request

CONF = os.path.expanduser("~/.config/sol-mc/watchlist")
CACHE = os.path.expanduser("~/.cache/sol-mc.json")
JUP_CACHE = os.path.expanduser("~/.cache/sol-mc-jupiter.json")
API = "https://api.dexscreener.com/latest/dex/tokens/{}"
JUP_API = "https://lite-api.jup.ag/price/v3?ids={}"
DS_MAX_AGE = 30   # DexScreener: Cache-Control max-age=30, polling faster returns the same data
JUP_MAX_AGE = 5   # Jupiter lite: max-age=5, and only ~5 requests per 10 s before HTTP 429
JUP_STALE = 30    # past this, a failed Jupiter fetch means DexScreener's own price is used
MAX_IN_PANEL = 3
ADDRESS_RE = re.compile(r"^[1-9A-HJ-NP-Za-km-z]{32,44}$")  # base58
HIDDEN = set()  # addresses written with a leading "-" in the watchlist


def read_watchlist():
    tokens = []
    try:
        with open(CONF) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if line:
                    addr, _, label = line.partition(" ")
                    if addr.startswith("-"):
                        addr = addr[1:]
                        HIDDEN.add(addr)
                    tokens.append((addr, label.strip()))
    except FileNotFoundError:
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w") as f:
            f.write("# One Solana token address per line, optional label after it.\n")
    return tokens


def fetch(addresses):
    """{address: best pair} for up to 30 addresses in one DexScreener call."""
    req = urllib.request.Request(API.format(",".join(addresses)), headers={"User-Agent": "sol-mc"})
    with urllib.request.urlopen(req, timeout=10) as resp:
        pairs = json.load(resp).get("pairs") or []
    best = {}
    for p in pairs:
        addr = p.get("baseToken", {}).get("address")
        if addr in addresses:
            liq = (p.get("liquidity") or {}).get("usd", 0)
            if addr not in best or liq > (best[addr].get("liquidity") or {}).get("usd", 0):
                best[addr] = p
    return best


def cached(path, addrs, max_age, fetcher):
    """(value, fetched_at) from a JSON file cache, refetched when older than max_age."""
    try:
        with open(path) as f:
            cache = json.load(f)
        if cache["addrs"] != addrs:
            cache = None
        elif time.time() - cache["at"] < max_age:
            return cache["value"], cache["at"]
    except (OSError, ValueError, KeyError):
        cache = None
    try:
        value = fetcher(addrs)
    except Exception:
        # Offline / API hiccup / rate limited: keep the last good numbers.
        return (cache["value"], cache["at"]) if cache else ({}, 0)
    with open(path + ".tmp", "w") as f:
        json.dump({"at": time.time(), "addrs": addrs, "value": value}, f)
    os.replace(path + ".tmp", path)
    return value, time.time()


def fetch_jupiter(addresses):
    """{address: USD price} from Jupiter."""
    req = urllib.request.Request(JUP_API.format(",".join(addresses)), headers={"User-Agent": "sol-mc"})
    with urllib.request.urlopen(req, timeout=5) as resp:
        return {a: float(v["usdPrice"]) for a, v in json.load(resp).items() if v and v.get("usdPrice")}


def data(tokens):
    addrs = [a for a, _ in tokens][:30]
    pairs, at = cached(CACHE, addrs, DS_MAX_AGE, fetch)
    prices, jup_at = cached(JUP_CACHE, addrs, JUP_MAX_AGE, fetch_jupiter)
    if not prices or time.time() - jup_at > JUP_STALE:
        return pairs, at
    live = {}
    for addr, p in pairs.items():
        p = dict(p)
        old, new = float(p.get("priceUsd") or 0), prices.get(addr)
        if old > 0 and new:
            # Supply doesn't change between DexScreener refreshes, so MC scales with price.
            for key in ("marketCap", "fdv"):
                if p.get(key):
                    p[key] = p[key] * new / old
            p["priceUsd"] = f"{new:.10g}"
            p["live"] = True
        live[addr] = p
    return live, max(at, jup_at)


def money(v):
    v = float(v or 0)
    for unit, div in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if v >= div:
            return f"${v / div:.1f}{unit}" if v / div < 100 else f"${v / div:.0f}{unit}"
    return f"${v:.0f}"


def change(p, windows=("m5", "h1", "h6", "h24")):
    """Price change per DexScreener window, e.g. "5m ▲0.7% 1h ▲0.3% 6h ▼2.7% 24h ▼10%"."""
    out = []
    for w in windows:
        c = (p.get("priceChange") or {}).get(w)
        if c is None:  # DexScreener drops a window with no trades / no movement in it
            out.append(f"{w[1:]}{w[0]} –")
            continue
        pct = f"{abs(c):.1f}" if abs(c) < 10 else f"{abs(c):.0f}"
        out.append(f"{w[1:]}{w[0]} {'▲' if c >= 0 else '▼'}{pct}%")
    return " ".join(out)


def name(p, label, full=False):
    t = p.get("baseToken", {})
    short = label or t.get("symbol", "?")
    return f"{t.get('name', '?')} ({short})" if full else short


def panel(tokens, pairs):
    tokens = [t for t in tokens if t[0] not in HIDDEN]
    if not tokens:
        return "◎ add token"
    parts = []
    for addr, label in tokens[:MAX_IN_PANEL]:
        p = pairs.get(addr)
        parts.append(f"{name(p, label)} {money(p.get('marketCap') or p.get('fdv'))} {change(p)}".strip() if p else f"{label or addr[:4]} ?")
    more = f" +{len(tokens) - MAX_IN_PANEL}" if len(tokens) > MAX_IN_PANEL else ""
    return "◎ " + " · ".join(parts) + more


def tooltip(tokens, pairs, at):
    if not tokens:
        return "No tokens yet - click to add a Solana token address"
    lines = []
    for addr, label in tokens:
        p = pairs.get(addr)
        if not p:
            lines.append(f"{label or addr}: no DexScreener pair found")
            continue
        lines.append(f"{name(p, label, full=True)}: MC {money(p.get('marketCap') or p.get('fdv'))} · "
                     f"${p.get('priceUsd', '?')} · {change(p) or 'no change data'}")
    age = int((time.time() - at) / 60) if at else None
    if age and age > 2:
        lines.append(f"(as of {age} min ago)")
    lines.append("Click to add / remove tokens")
    return "\n".join(lines)


def line(addr, label):
    return f"{'-' if addr in HIDDEN else ''}{addr} {label}".strip()


def write_watchlist(lines):
    with open(CONF, "w") as f:
        f.write("# One Solana token address per line, optional label after it.\n")
        f.writelines(l + "\n" for l in lines)


def add(tokens, addr):
    """Validate against DexScreener, then append. Returns (ok, message)."""
    addr = addr.strip()
    if not ADDRESS_RE.match(addr):
        return False, "That doesn't look like a Solana address."
    if addr in (a for a, _ in tokens):
        return False, "Already on the watchlist."
    try:
        p = fetch([addr]).get(addr)
    except Exception as e:
        return False, f"DexScreener lookup failed: {e}"
    if not p:
        return False, "DexScreener has no trading pair for that address."
    t = p["baseToken"]
    write_watchlist([line(a, l) for a, l in tokens] + [line(addr, t.get("symbol", ""))])
    return True, f"Added {t.get('name')} ({t.get('symbol')})"


def as_json(tokens, pairs, at):
    """Everything the widget shows, one object per token."""
    out = []
    for addr, label in tokens:
        p = pairs.get(addr)
        t = (p or {}).get("baseToken", {})
        out.append({
            "address": addr,
            "symbol": label or t.get("symbol") or addr[:4],
            "name": t.get("name", ""),
            "found": bool(p),
            "hidden": addr in HIDDEN,
            "marketCap": money(p.get("marketCap") or p.get("fdv")) if p else "",
            "price": p.get("priceUsd", "") if p else "",
            "changes": (p or {}).get("priceChange") or {},
            "url": (p or {}).get("url") or f"https://dexscreener.com/solana/{addr}",
        })
    return {"tokens": out, "age": int(time.time() - at) if at else None}


def main():
    tokens = read_watchlist()
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode in ("--add", "--remove", "--hide", "--show"):
        arg = sys.argv[2] if len(sys.argv) > 2 else ""
        if mode == "--add":
            ok, msg = add(tokens, arg)
        else:
            if mode == "--hide":
                HIDDEN.add(arg)
            elif mode == "--show":
                HIDDEN.discard(arg)
            write_watchlist([line(a, l) for a, l in tokens if not (mode == "--remove" and a == arg)])
            ok, msg = True, {"--remove": "Removed", "--hide": "Hidden from the panel", "--show": "Shown on the panel"}[mode]
        HIDDEN.clear()
        tokens = read_watchlist()
        pairs, at = data(tokens) if tokens else ({}, 0)
        print(json.dumps({"ok": ok, "message": msg, **as_json(tokens, pairs, at)}))
        return
    pairs, at = data(tokens) if tokens else ({}, 0)
    if mode == "--json":
        print(json.dumps(as_json(tokens, pairs, at)))
    else:
        print(tooltip(tokens, pairs, at) if mode == "--tooltip" else panel(tokens, pairs))


if __name__ == "__main__":
    main()
